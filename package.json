{
  "name": "stars-manager",
  "private": true,
  "version": "0.7.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "cf:types": "wrangler types",
    "cf:typecheck": "tsc -p worker/tsconfig.json",
    "cf:migrate:local": "wrangler d1 migrations apply github-stars-manager --local",
    "cf:migrate:remote": "wrangler d1 migrations apply github-stars-manager --remote",
    "cf:dev": "npm run build && wrangler d1 migrations apply github-stars-manager --local && wrangler dev",
    "cf:check": "npm run cf:types && npm run cf:typecheck && npm run build && wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "date-fns": "^3.3.1",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.9",
    "vue": "^3.5.41",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260813.1",
    "@eslint/js": "^9.9.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-legacy": "^8.0.1",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "globals": "^15.9.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.0.9",
    "vitest": "^1.3.1",
    "wrangler": "^4.122.0"
  }
}
